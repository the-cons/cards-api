{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "JsonWriterOptions": {
          "Indented": true
        }
      }
    }
  },
  "Cards": {
    "MaxCollectionSize": 5
  },
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "ValidAudiences": [
          "http://localhost:5183",
          "https://localhost:7177"
        ],
        "ValidIssuer": "dotnet-user-jwts"
      }
    }
  }
}