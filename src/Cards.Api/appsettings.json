{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": { "IncludeScopes": true }
    }
  },
  "AllowedHosts": "*",
  "Cards": { "MaxCollectionSize": 100 },
  "ConnectionStrings": { "Cards": "Data Source=cards.db" }
}